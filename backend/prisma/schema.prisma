datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Wallet {
  address   String   @id
  nonce     String?  @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  lastLogin DateTime?

  profiles Profile[]
}

model Profile {
  id            Int     @id @default(autoincrement())
  walletAddress String  @unique
  roleCode      String
  displayName   String
  avatarUrl     String?
  location      String?
  coordinates   String?

  wallet Wallet @relation(fields: [walletAddress], references: [address])
  mintedBatches       ProductBatch[]        @relation("ProfileBatches")
  issuedCertificates  Certificate[]         @relation("CertificateIssuer")
  subjectCertificates Certificate[]         @relation("CertificateSubject")
  warehouseInventory  WarehouseInventory[]  @relation("WarehouseOwner")
}

model ProductBatch {
  id               Int      @id @default(autoincrement())
  batchId          String   @unique
  name             String
  description      String?
  image            String?
  sku              String?
  grossWeightKg    Float?
  netWeightKg      Float?
  originSiteCode   String?
  standard         String?
  mintTxHash       String?
  policyId         String?
  expiryDate       DateTime?
  referenceUtxo    String?
  lastUpdateTxHash String?
  lastUpdateAt     DateTime?
  revokeTxHash     String?
  revokedAt        DateTime?
  revoked          Boolean  @default(false)
  burnTxHash       String?
  burnedAt         DateTime?
  burned           Boolean  @default(false)
  createdAt        DateTime @default(now())

  minterProfileId  Int
  minterProfile    Profile  @relation("ProfileBatches", fields: [minterProfileId], references: [id])

  certificates     Certificate[]
  roadmaps         Roadmap[]
  inventories      WarehouseInventory[]
}

model WarehouseInventory {
  id          Int       @id @default(autoincrement())
  batchId     String
  profileId   Int
  status      String    @default("IN_WAREHOUSE")
  receivedAt  DateTime  @default(now())
  warehouseCode String?
  zone          String?
  aisle         String?
  rack          String?
  bin           String?
  lastMovedAt   DateTime?
  shippedAt     DateTime?
  consumedAt    DateTime?
  burnTxHash    String?

  batch   ProductBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  profile Profile      @relation("WarehouseOwner", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([batchId, profileId])
}

model Certificate {
  id               Int       @id @default(autoincrement())
  title            String
  imageUrl         String?
  issuedAt         DateTime  @default(now())
  number           String?
  authority        String?
  expiryDate       DateTime?
  documentType     String?
  standardReference String?
  scope            String?
  documentUrl      String?

  issuerProfileId  Int
  issuerProfile    Profile      @relation("CertificateIssuer", fields: [issuerProfileId], references: [id])
  subjectProfileId Int?
  subjectProfile   Profile?     @relation("CertificateSubject", fields: [subjectProfileId], references: [id])

  productBatches   ProductBatch[]
}

model Roadmap {
  id              Int      @id @default(autoincrement())
  batchId         String
  fromAddress     String   @default("")
  toAddress       String
  stepIndex       Int      @default(0)
  action          String
  txHash          String?
  createdAt       DateTime @default(now())
  legType         String?
  transportMode   String?
  carrierName     String?
  routeCode       String?
  plannedDepartureAt DateTime?
  plannedArrivalAt   DateTime?
  actualDepartureAt  DateTime?
  actualArrivalAt    DateTime?

  batch           ProductBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
}

model DeliveryOrder {
  id                     Int                @id @default(autoincrement())
  lockTxHash             String
  scriptOutputIndex      Int                @default(0)
  batchId                String
  policyId               String?
  scriptAddress          String?
  datumHash              String?
  datumJson              Json?
  recipientAddress       String
  senderAddress          String
  ownerAddresses         Json
  status                 DeliveryStatus    @default(IN_TRANSIT)
  partialSignedTxHex     String?            @db.Text
  partialSignedByAddress String?
  secondSignedByAddress  String?
  unlockTxHash           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  shipmentNo             String?
  customerCode           String?
  shipToName             String?
  shipToAddress          String?
  shipToCity             String?
  shipToCountry          String?
  shipToPhone            String?
  carrierName            String?
  transportMode          String?
  trackingNumber         String?
  plannedPickupAt        DateTime?
  plannedDeliveryAt      DateTime?
  actualPickupAt         DateTime?
  actualDeliveryAt       DateTime?

  @@unique([lockTxHash, scriptOutputIndex])
}

