datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Wallet {
  address   String   @id
  nonce     String?  @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  lastLogin DateTime?

  profiles Profile[]
}

model Profile {
  id            Int     @id @default(autoincrement())
  walletAddress String  @unique
  roleCode      String
  displayName   String
  avatarUrl     String?
  location      String?
  coordinates   String?

  wallet Wallet @relation(fields: [walletAddress], references: [address])
  mintedBatches       ProductBatch[]        @relation("ProfileBatches")
  warehouseInventory  WarehouseInventory[]  @relation("WarehouseOwner")
}

model ProductBatch {
  id               Int      @id @default(autoincrement())
  batchId          String   @unique
  name             String
  description      String?
  image            String?
  certificate      String?
  sku              String?
  grossWeightKg    Float?
  netWeightKg      Float?
  originSiteCode   String?
  standard         String?
  mintTxHash       String?
  policyId         String?
  expiryDate       DateTime?
  referenceUtxo    String?
  createdAt        DateTime @default(now())

  minterProfileId  Int
  minterProfile    Profile  @relation("ProfileBatches", fields: [minterProfileId], references: [id])

  inventories      WarehouseInventory[]
}

model WarehouseInventory {
  id           Int       @id @default(autoincrement())
  batchId      String
  profileId    Int
  status       String    @default("IN_WAREHOUSE")
  receivedAt   DateTime  @default(now())
  lastMovedAt  DateTime?
  shippedAt    DateTime?
  consumedAt   DateTime?

  batch   ProductBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  profile Profile      @relation("WarehouseOwner", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([batchId, profileId])
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
}

model DeliveryOrder {
  id                     Int                @id @default(autoincrement())
  lockTxHash             String
  scriptOutputIndex      Int                @default(0)
  batchId                String
  policyId               String?
  scriptAddress          String?
  recipientAddress       String
  senderAddress          String
  ownerAddresses         Json
  status                 DeliveryStatus    @default(IN_TRANSIT)
  partialSignedTxHex     String?            @db.Text
  partialSignedByAddress String?
  secondSignedByAddress  String?
  unlockTxHash           String?
  actualDeliveryAt       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([lockTxHash, scriptOutputIndex])
}

