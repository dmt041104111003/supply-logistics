datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Wallet {
  address   String   @id
  nonce     String?  @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  lastLogin DateTime?

  profiles Profile[]
}

model Role {
  id   Int    @id @default(autoincrement())
  code String @unique

  profiles Profile[]
}

model Profile {
  id            Int     @id @default(autoincrement())
  walletAddress String  @unique
  roleId        Int
  displayName   String
  avatarUrl     String?
  location      String?
  coordinates   String?

  wallet Wallet @relation(fields: [walletAddress], references: [address])
  role   Role   @relation(fields: [roleId], references: [id])

  mintedBatches       ProductBatch[]   @relation("ProfileBatches")
  issuedCertificates  Certificate[]     @relation("CertificateIssuer")
  warehouseInventory  WarehouseInventory[]   @relation("WarehouseOwner")
}

model ProductBatch {
  id              Int      @id @default(autoincrement())
  code            String   @unique 
  name            String
  description     String?
  image           String?
  standard        String?
  properties      Json?
  metadata        Json?
  mintTxHash      String?
  policyId        String?
  createdAt       DateTime @default(now())

  minterProfileId Int
  minterProfile   Profile  @relation("ProfileBatches", fields: [minterProfileId], references: [id])

  certificates    Certificate[]
  roadmaps        Roadmap[]
  inventories     WarehouseInventory[]
}

model WarehouseInventory {
  id          Int       @id @default(autoincrement())
  batchId     String
  profileId   Int
  status      String    @default("IN_WAREHOUSE")
  mintedAt    DateTime  @default(now())

  batch   ProductBatch @relation(fields: [batchId], references: [code], onDelete: Cascade)
  profile Profile      @relation("WarehouseOwner", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([batchId, profileId])
}

model Certificate {
  id               Int       @id @default(autoincrement())
  title            String
  imageUrl         String?
  issuedAt         DateTime  @default(now())
  number           String?
  authority        String?
  expiryDate       DateTime?

  batchId          String
  batch            ProductBatch @relation(fields: [batchId], references: [code])

  issuerProfileId  Int
  issuerProfile    Profile      @relation("CertificateIssuer", fields: [issuerProfileId], references: [id])
}

model Roadmap {
  id              Int      @id @default(autoincrement())
  batchId         String
  senderAddress   String   @default("")
  receiverAddress String
  hopIndex        Int      @default(0)
  action          String
  txHash          String?
  createdAt       DateTime @default(now())

  batch           ProductBatch @relation(fields: [batchId], references: [code], onDelete: Cascade)
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
}

model DeliveryOrder {
  id                     Int                @id @default(autoincrement())
  lockTxHash             String
  scriptOutputIndex      Int                @default(0)
  batchId                String
  policyId               String?
  recipientAddress       String
  senderAddress          String
  ownerAddresses         Json
  status                 DeliveryStatus    @default(IN_TRANSIT)
  partialSignedTxHex     String?            @db.Text
  partialSignedByAddress String?
  secondSignedByAddress  String?
  unlockTxHash           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([lockTxHash, scriptOutputIndex])
}

